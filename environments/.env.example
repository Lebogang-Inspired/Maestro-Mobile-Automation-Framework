# ---------------------------------------------------------------------------
# Example environment configuration for the Maestro POC framework.
# Copy to `environments/.env.poc` (or .env.sit / .env.uat) and adjust.
# NEVER commit a real .env file — only this .example is tracked (see .gitignore).
# ---------------------------------------------------------------------------

# Target environment label (POC | SIT | UAT). POC == the installed demo app.
TARGET_ENV=POC

# Application under test (verified installed package id).
APP_ID=com.saucelabs.mydemoapp.android

# Device/emulator id. Leave blank to let Maestro pick the only running device,
# or set explicitly when several devices are attached (maestro test --device ...).
DEVICE_ID=emulator-5554

# --- Credentials -----------------------------------------------------------
# These are the SYNTHETIC demo credentials the app itself displays on its login
# screen. They are not real secrets. For SIT/UAT, supply environment-specific
# test accounts via a secret store / CI variable group, never in a tracked file.
TEST_USERNAME=bod@example.com
TEST_PASSWORD=10203040

# Negative-path data (used by TC003 documentation; the test itself submits empty
# fields to trigger the app's real validation error).
INVALID_USERNAME=invalid@example.com
INVALID_PASSWORD=wrongpass

# --- Synthetic checkout data (TC007). No real payment is processed. ---------
# Values with spaces MUST be quoted so the file is safe to `source` in shell.
SHIP_NAME="Test Automation"
SHIP_ADDRESS="123 Demo Street"
SHIP_CITY="Testville"
SHIP_ZIP="12345"
SHIP_COUNTRY="Testland"
CARD_NAME="Test Automation"
CARD_NUMBER="3258125675687891"
CARD_EXPIRY="03/25"
CARD_CVV="123"
